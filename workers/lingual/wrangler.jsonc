/**
 * pvtch Lingual Worker
 *
 * The Lingual handler: translates chat for channels that turned Lingual on.
 * Consumes `lingual-events`, which pvtch-twitch's router fans chat events
 * into, and replies by enqueuing `send` requests on `twitch-events`. Holds no
 * Twitch credentials and serves no routes.
 *
 * Deploy order: pvtch-storage first (TWITCH_CHANNEL). The lingual-events
 * queues must exist.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pvtch-lingual",
  // pvtch's Cloudflare account. Keeps local wrangler commands from landing
  // in another account the CLI happens to be logged into.
  "account_id": "bda0488147d6159dfe8913c8ee9d2413",
  "main": "./src/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-04-01",
  "upload_source_maps": true,
  "workers_dev": false,

  "observability": {
    "enabled": true,
  },

  "ai": {
    "binding": "AI",
  },

  /**
   * The v2 translation flow, used by channels with lingual.translate-v2.
   *   DETECTOR_API              "decisions" for decisions models, else "chat"
   *   DETECTOR_MODEL            provider/model
   *   MAX_TARGET_PROBABILITY    translate at or below this score that the
   *                             message is in the target language. Scores are
   *                             model-specific: change it with the detector.
   *                             Decider puts foreign text at about 0.001 to
   *                             0.07, and "merci" or "c'est la vie" from 0.16.
   *   TRANSLATOR_MODEL          provider/model
   *   DISABLE_THINKING          "true" sends reasoning off. The models must
   *                             support it, or requests find no endpoint.
   * An invalid value keeps v2 quiet. Check a new pair at /evals in the harness.
   */
  "vars": {
    "LINGUAL_V2_DETECTOR_API": "decisions",
    "LINGUAL_V2_DETECTOR_MODEL": "perplexity/pplx-decider-v1.2",
    "LINGUAL_V2_MAX_TARGET_PROBABILITY": "0.1",
    "LINGUAL_V2_TRANSLATOR_MODEL": "google/gemma-3-12b-it",
    "LINGUAL_V2_DISABLE_THINKING": "false",
  },

  /**
   * Account-level Secrets Store. Read it with readSecret() from
   * @pvtch/shared/secrets: a store binding is an object with an async get().
   * PVTCH_OPENROUTER_API_KEY must exist in the store before this worker deploys.
   */
  "secrets_store_secrets": [
    {
      "binding": "PVTCH_OPENROUTER_API_KEY",
      "store_id": "a50693a341154908beed43817b887121",
      "secret_name": "PVTCH_OPENROUTER_API_KEY",
    },
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "TWITCH_CHANNEL",
        "class_name": "TwitchChannel",
        "script_name": "pvtch-storage",
      },
    ],
  },

  /**
   * MANUAL SETUP REQUIRED: create the queues before deploying.
   *   wrangler queues create lingual-events
   *   wrangler queues create lingual-events-dlq
   */
  "queues": {
    "producers": [
      {
        "queue": "twitch-events",
        "binding": "TWITCH_EVENTS",
      },
    ],
    "consumers": [
      {
        "queue": "lingual-events",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 10,
        "dead_letter_queue": "lingual-events-dlq",
      },
      // Logs each message that exhausted its retries above, then acks it.
      {
        "queue": "lingual-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
      },
    ],
  },
}
