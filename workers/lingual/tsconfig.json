{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  // Storage sources are included for types only: the generated Env types
  // TWITCH_CHANNEL via ../storage/src.
  "include": [
    "src/**/*",
    "test/**/*",
    "worker-configuration.d.ts",
    "../storage/src/**/*"
  ],
  "exclude": ["node_modules"]
}
