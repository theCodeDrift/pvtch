{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pvtch",
  // pvtch's Cloudflare account. Keeps local wrangler commands from landing
  // in another account the CLI happens to be logged into.
  "account_id": "bda0488147d6159dfe8913c8ee9d2413",
  "main": "./cloudflare/handler.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-04-01",
  "upload_source_maps": true,

  // www is declared here so deploys keep it bound to this worker.
  "routes": [
    {
      "pattern": "www.pvtch.com",
      "custom_domain": true,
    },
  ],

  "vars": {
    "TWITCH_CLIENT_ID": "yrx2abngfobvh0zhgdwgwbr5yzbqop",
    "TWITCH_REDIRECT_URI": "https://www.pvtch.com/auth/callback",
    "PVTCH_APP_URL": "https://www.pvtch.com",
    "ALLOWED_USERS": "",
    // Twitch logins who can see Bots > Lingual during rollout. Empty shows it
    // to no one (unlike ALLOWED_USERS, where empty means open).
    "LINGUAL_PREVIEW_USERS": "theCodeDrift",
  },

  /**
   * Account-level Secrets Store. TWITCH_SECRET is the shared Twitch app's
   * client secret, used by pvtch-api and pvtch-twitch. Read it with
   * readSecret() from @pvtch/shared/secrets: a store binding is an object
   * with an async get(), not a string.
   */
  "secrets_store_secrets": [
    {
      "binding": "TWITCH_SECRET",
      "store_id": "a50693a341154908beed43817b887121",
      "secret_name": "TWITCH_SECRET",
    },
  ],

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MyDurableObject"],
    },
    {
      "tag": "v2",
      "renamed_classes": [{ "from": "MyDurableObject", "to": "PvtchBackend" }],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["User"],
    },
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "PVTCH_BACKEND",
        "class_name": "PvtchBackend",
      },
      {
        "name": "PVTCH_USER",
        "class_name": "User",
      },
      {
        // Lives in pvtch-storage, which deploys first. See STYLEGUIDE-CODE.md.
        "name": "TWITCH_CHANNEL",
        "class_name": "TwitchChannel",
        "script_name": "pvtch-storage",
      },
    ],
  },

  "kv_namespaces": [
    {
      "binding": "PVTCH_KV",
      "id": "3588c48277284bfb8e673399f904b794",
    },
    {
      "binding": "PVTCH_ACCOUNTS",
      "id": "bc19b133947e4936b7ce4d808b27023e",
    },
  ],

  "ai": {
    "binding": "AI",
  },

  "observability": {
    "enabled": true,
  },
}
