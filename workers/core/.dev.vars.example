# Copy this file to .dev.vars and fill in your values

# TWITCH_SECRET is a Secrets Store binding (see wrangler.jsonc), not a dev
# var. Create it once in Wrangler's local secrets store:
#   wrangler secrets-store secret create a50693a341154908beed43817b887121 \
#     --name TWITCH_SECRET --scopes workers

# Optional: Override for local development
# TWITCH_REDIRECT_URI=http://localhost:8787/auth/callback
# PVTCH_APP_URL=http://localhost:8787

# Optional: Skip Twitch login entirely in dev by impersonating a user ID
# When set and PVTCH_APP_URL is localhost, every page, the scope grant and
# every overlay URL act as this Twitch user ID. Ignored on any other host.
# DEV_TWITCH_USER_ID=123456789

# Optional: Restrict this instance to specific Twitch usernames (comma-separated)
# When set, only these users can access widgets and OBS sources
# ALLOWED_USERS=alice,bob,charlie
