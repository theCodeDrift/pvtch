{
  "name": "@pvtch/twitch",
  "dependencies": {
    "@pvtch/shared": "workspace:*",
    "franc-min": "^6.2.0",
    "tinyld": "^1.3.4",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  },
  "private": true,
  "scripts": {
    "cf-typegen": "wrangler types -c wrangler.jsonc -c ../storage/wrangler.jsonc",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev -c wrangler.jsonc -c ../storage/wrangler.jsonc --persist-to ../../.wrangler",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit"
  },
  "type": "module"
}
