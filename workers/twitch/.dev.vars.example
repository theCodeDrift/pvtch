# Both secrets are Secrets Store bindings (see wrangler.jsonc), not dev vars.
# Create them once in Wrangler's local secrets store:
#   wrangler secrets-store secret create a50693a341154908beed43817b887121 \
#     --name TWITCH_SECRET --scopes workers
#   wrangler secrets-store secret create a50693a341154908beed43817b887121 \
#     --name TWITCH_EVENTSUB_SECRET --scopes workers
